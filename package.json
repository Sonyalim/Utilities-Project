{
  "name": "utilities-project",
  "version": "1.0.0",
  "description": "Playwright and BDD starter project for UI and API test automation.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "bddgen && playwright test --project=ui --project=bdd",
    "start:demo": "node app/server.js",
    "generate:rtm": "node scripts/generate-rtm.js",
    "generate:scenarios": "tsx ai/generate-scenarios.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sonyalim/Utilities-Project.git"
  },
