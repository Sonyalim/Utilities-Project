  "bugs": {
    "url": "https://github.com/Sonyalim/Utilities-Project/issues"
  },
  "homepage": "https://github.com/Sonyalim/Utilities-Project#readme",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "playwright-bdd": "^9.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
